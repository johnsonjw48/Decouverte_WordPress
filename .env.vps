# Configuration WordPress pour VPS avec nginx existant
# Copier ce fichier vers .env et modifier les valeurs

# Base de données MySQL
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=CHANGEZ_MOI_MOT_DE_PASSE_FORT
MYSQL_ROOT_PASSWORD=CHANGEZ_MOI_ROOT_PASSWORD_FORT

# Port WordPress (choisir un port libre sur votre VPS)
# Exemples: 8083, 8084, 8085, etc.
# Évitez 8080 et 8082 si déjà utilisés par vos APIs Symfony
WORDPRESS_PORT=8083

# PhpMyAdmin (optionnel en production)
# Laissez désactivé ou utilisez un port élevé
PHPMYADMIN_PORT=8084

# Mode debug (false en production)
WORDPRESS_DEBUG=false
